{
  "name": "unscrewed",
  "private": true,
  "version": "0.0.1",
  "description": "Barter marketplace on Cloudflare",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* dev",
    "build": "pnpm -r --filter=./apps/* build",
    "build:web": "pnpm --filter @unscrewed/web build",
    "deploy:api": "pnpm --filter @unscrewed/api exec wrangler deploy",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "license": "AGPL-3.0-only"
}
